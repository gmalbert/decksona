{
  "name": "decksona",
  "version": "0.2.1",
  "private": true,
  "main": "main.js",
  "scripts": {
    "build:audio": "node scripts/build-audio.cjs",
    "dist:web": "npm run build:audio && node scripts/package-web.cjs",
    "precheck:skins": "npm run build:audio",
    "prepreview:skins": "npm run build:audio",
    "check:audio": "npm run build:audio && electron scripts/verify-audio.cjs",
    "check:web-audio": "npm run build:audio && electron scripts/verify-web-audio.cjs",
    "prestart": "npm run build:audio",
    "predist:win": "npm run build:audio",
    "predist:win:installer": "npm run build:audio",
    "predist:mac": "npm run build:audio",
    "predist:mac:local": "npm run build:audio",
    "predist:mac:notarized": "npm run build:audio",
    "start": "electron .",
    "web": "node web/server.js",
    "preweb": "npm run build:audio",
    "sync:skins": "node scripts/build-skins.js",
    "check:skins": "electron scripts/verify-skins.cjs",
    "preview:skins": "electron scripts/verify-skins.cjs --generate-previews",
    "check": "node --check main.js && node --check preload.js && node --check renderer.js && node --check web/app.js && node --check web/radio.js && node --check themes.js && node --check listening.js && node --check listening-core.js && node --test tests/*.test.js",
    "dist:win": "electron-builder --win portable --publish never",
    "dist:win:installer": "electron-builder --win nsis",
    "dist:mac": "electron-builder --mac dmg --publish never -c.mac.identity=- -c.mac.hardenedRuntime=false -c.mac.notarize=false -c.afterSign=./scripts/verify-mac-release.cjs -c.directories.output=dist/mac",
    "dist:mac:local": "electron-builder --mac dmg --publish never -c.mac.identity=- -c.mac.hardenedRuntime=false -c.mac.notarize=false -c.directories.output=dist/local",
    "dist:mac:notarized": "electron-builder --mac dmg --publish never -c.mac.forceCodeSigning=true -c.mac.type=distribution -c.mac.notarize=false -c.dmg.sign=true -c.dmg.writeUpdateInfo=false -c.afterSign=./scripts/verify-mac-release.cjs -c.artifactBuildCompleted=./scripts/notarize-mac-dmg.cjs",
    "check:listening": "npm run build:audio && electron scripts/verify-listening.cjs",
    "sync:version": "node scripts/sync-version.cjs",
    "version": "npm run sync:version"
  },
  "devDependencies": {
    "electron": "45.3.4",
    "electron-builder": "^26.0.0",
    "esbuild": "0.28.2"
  },
  "build": {
    "appId": "com.decksona.player",
    "productName": "Decksona",
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "index.html",
      "style.css",
      "api.js",
      "themes.js",
      "player-session.js",
      "local-audio-config.js",
      "local-player.js",
      "web/radio.js",
      "desktop-audio.bundle.js",
      "themes.css",
      "skins/**",
      "skin-previews/**",
      "assets/**",
      "listening-core.js",
      "listening.js",
      "listening.css"
    ],
    "win": {
      "artifactName": "Decksona.exe",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.music",
      "icon": "assets/icon.icns"
    }
  },
  "description": "A retro desktop player for Music Assistant",
  "allowScripts": {
    "electron@45.3.4": true,
    "esbuild@0.28.2": true
  },
  "dependencies": {
    "@sendspin/sendspin-js": "6.0.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
